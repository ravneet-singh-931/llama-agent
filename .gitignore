# Environment variables (NEVER commit these!)
.env

# Secrets (NEVER commit real secrets!)
secrets/

# SSL certificates
config/nginx/ssl/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Coverage
.coverage
coverage.xml

# Logs
logs/
*.log

# Uploads
uploads/

# Data files
conversation_memory.json
fact_memory.json
notes.txt

# Test artifacts
tests/_tmp_memory_test.json

# Runtime data (ChromaDB, embeddings, etc.)
data/

# Runtime DB tooling state (was created by modules/database_improvements.py,
# deleted in #10). NOTE: `migrations/` is NOT ignored any more — that name now
# belongs to Alembic, whose revision files MUST be committed. Ignoring it would
# mean every developer and every deploy generates its own history.
backups/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Evaluation reports (generated)
evals/results/

# Locally downloaded RAG reranker model (scripts/download_reranker.py)
/models/
