# Nginx reverse proxy (TLS termination, routing, rate limiting)
FROM nginx:1.27-alpine

# openssl: generate a self-signed cert on first start when none is mounted
RUN apk add --no-cache openssl \
    && rm /etc/nginx/conf.d/default.conf \
    && mkdir -p /etc/nginx/ssl /etc/nginx/ssl-provided /var/www/certbot

COPY config/nginx/nginx.conf /etc/nginx/conf.d/default.conf
# Executed by the official image's entrypoint before nginx starts
COPY config/nginx/ensure-cert.sh /docker-entrypoint.d/05-ensure-cert.sh
RUN chmod +x /docker-entrypoint.d/05-ensure-cert.sh

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
