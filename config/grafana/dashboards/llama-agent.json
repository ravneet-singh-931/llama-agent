{
  "annotations": { "list": [] },
  "editable": true,
  "title": "Llama Agent - Operations Dashboard",
  "uid": "llama-agent-ops",
  "tags": ["llama-agent", "operations", "monitoring"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Total API Requests",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(llama_agent_requests_total)",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(llama_agent_errors_total)",
          "legendFormat": "Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "title": "Avg Response Time",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum without (instance) (rate(llama_agent_response_time_seconds_sum[5m])) / sum without (instance) (rate(llama_agent_response_time_seconds_count[5m]))",
          "legendFormat": "Avg Time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "time() - min(llama_agent_start_time)",
          "legendFormat": "Uptime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      }
    },

    {
      "title": "Requests per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum without (instance) (rate(llama_agent_requests_total[5m]))",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Response Time Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum without (instance) (rate(llama_agent_response_time_seconds_sum[5m])) / sum without (instance) (rate(llama_agent_response_time_seconds_count[5m]))",
          "legendFormat": "Avg Response Time"
        },
        {
          "expr": "histogram_quantile(0.95, sum without (instance) (rate(llama_agent_response_time_seconds_bucket[5m])))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum without (instance) (rate(llama_agent_response_time_seconds_bucket[5m])))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      }
    },

    {
      "title": "HTTP Status Codes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum without (instance) (rate(llama_agent_http_responses_total[5m]))",
          "legendFormat": "{{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Active Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "sum(llama_agent_active_connections)",
          "legendFormat": "Active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },

    {
      "title": "Requests by Endpoint",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "topk(10, sum without (instance) (llama_agent_requests_total))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Error Rate Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "expr": "sum without (instance) (rate(llama_agent_errors_total[5m]))",
          "legendFormat": "errors/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "err/s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },

    {
      "title": "System: CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "title": "System: Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "targets": [
        {
          "expr": "100 - ((node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100)",
          "legendFormat": "Memory %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },

    {
      "title": "Response Time Histogram",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 38 },
      "targets": [
        {
          "expr": "sum without (instance) (llama_agent_response_time_seconds_bucket)",
          "legendFormat": "{{le}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "LLM input tokens per minute (vs free-tier ITPM limit)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "targets": [{ "expr": "sum by (model) (rate(llama_agent_llm_tokens_total{kind=\"input\"}[1m]) * 60)", "legendFormat": "{{model}}" }]
    },
    {
      "title": "LLMOps guard actions (5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "targets": [{ "expr": "sum by (action) (increase(llama_agent_llm_guard_events_total[5m]))", "legendFormat": "{{action}}" }]
    },
    {
      "title": "Tokens trimmed by context compaction (5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
      "targets": [{ "expr": "sum by (model) (increase(llama_agent_llm_tokens_trimmed_total[5m]))", "legendFormat": "{{model}}" }]
    },
    {
      "title": "Estimated LLM spend (USD, cumulative)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 54 },
      "targets": [{ "expr": "sum by (model) (llama_agent_llm_cost_usd_total)", "legendFormat": "{{model}}" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "title": "Grounding rate - figures found in sources (1h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 62 },
      "targets": [{ "expr": "sum(increase(llama_agent_grounding_claims_total{result=\"supported\"}[1h])) / sum(increase(llama_agent_grounding_claims_total[1h]))", "legendFormat": "grounded share" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "title": "Estimated LLM spend by component (USD, cumulative)",
      "description": "Which part of the app spends the tokens: each agent, chat, doc answers, RAG helpers, router, eval judge.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 70 },
      "targets": [{ "expr": "sum by (component) (llama_agent_llm_cost_usd_total)", "legendFormat": "{{component}}" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "title": "Agent run time p50 / p95 (1h)",
      "description": "Wall time of one specialist-agent run (tool loop + answer), excluding cancelled runs.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 70 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (agent, le) (rate(llama_agent_agent_run_seconds_bucket{outcome!=\"cancelled\"}[1h])))", "legendFormat": "{{agent}} p50" },
        { "expr": "histogram_quantile(0.95, sum by (agent, le) (rate(llama_agent_agent_run_seconds_bucket{outcome!=\"cancelled\"}[1h])))", "legendFormat": "{{agent}} p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Agent failure rate (1h)",
      "description": "Share of agent runs that ended in an error or a failure message (same markers as the eval's completed check). Cancelled runs are excluded.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 78 },
      "targets": [{ "expr": "sum by (agent) (increase(llama_agent_agent_run_seconds_count{outcome=~\"failed|error\"}[1h])) / sum by (agent) (increase(llama_agent_agent_run_seconds_count{outcome!=\"cancelled\"}[1h]))", "legendFormat": "{{agent}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "title": "SLO: chats answered (30d, target 95%)",
      "description": "Share of /chat/stream messages that ended with an answer, not an error or a failure notice. Cancelled chats are excluded. Green = SLO met.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 86 },
      "targets": [{ "expr": "sum(increase(llama_agent_chat_seconds_count{outcome=\"ok\"}[30d])) / sum(increase(llama_agent_chat_seconds_count{outcome!=\"cancelled\"}[30d]))", "legendFormat": "30d" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "noValue": "no chats yet", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.95 }] } } }
    },
    {
      "title": "SLO: quick answers within 10 s (30d, target 95%)",
      "description": "Commands, document questions and general chat: share of answered chats the user got within 10 s, start to end of the stream.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 86 },
      "targets": [{ "expr": "sum(increase(llama_agent_chat_seconds_bucket{route=~\"command|document|general\",outcome=\"ok\",le=~\"10(\\\\.0)?\"}[30d])) / sum(increase(llama_agent_chat_seconds_count{route=~\"command|document|general\",outcome=\"ok\"}[30d]))", "legendFormat": "30d" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "noValue": "no chats yet", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.95 }] } } }
    },
    {
      "title": "SLO: agent answers within 90 s (30d, target 95%)",
      "description": "Single-agent answers (research, coder, writer, planner, analyzer): share delivered within 90 s, start to end of the stream. @team has no latency SLO.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 86 },
      "targets": [{ "expr": "sum(increase(llama_agent_chat_seconds_bucket{route=\"agent\",outcome=\"ok\",le=~\"90(\\\\.0)?\"}[30d])) / sum(increase(llama_agent_chat_seconds_count{route=\"agent\",outcome=\"ok\"}[30d]))", "legendFormat": "30d" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "noValue": "no chats yet", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.95 }] } } }
    },
    {
      "title": "Chat answer time p50 / p95 by route (1h)",
      "description": "What the user waits on /chat/stream: message received to the end of the answer stream. Cancelled chats excluded.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 92 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (route, le) (rate(llama_agent_chat_seconds_bucket{outcome!=\"cancelled\"}[1h])))", "legendFormat": "{{route}} p50" },
        { "expr": "histogram_quantile(0.95, sum by (route, le) (rate(llama_agent_chat_seconds_bucket{outcome!=\"cancelled\"}[1h])))", "legendFormat": "{{route}} p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Time to first answer text p50 / p95 by route (1h)",
      "description": "Message received to the first answer text on screen (reasoning, tool and config events don't count; for @team, the first agent's section).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 92 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (route, le) (rate(llama_agent_chat_first_token_seconds_bucket[1h])))", "legendFormat": "{{route}} p50" },
        { "expr": "histogram_quantile(0.95, sum by (route, le) (rate(llama_agent_chat_first_token_seconds_bucket[1h])))", "legendFormat": "{{route}} p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "SLO error-budget burn rate (1h window)",
      "description": "1 = spending the 5% error budget exactly over 30 days. The burn-rate alerts fire at 14.4 (1h and 5m) or 6 (6h and 30m), with at least 5 chats in the window.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 100 },
      "targets": [
        { "expr": "llama_agent:chat_unanswered:ratio_rate1h / 0.05", "legendFormat": "availability" },
        { "expr": "llama_agent:chat_quick_slow:ratio_rate1h / 0.05", "legendFormat": "quick latency (10 s)" },
        { "expr": "llama_agent:chat_agent_slow:ratio_rate1h / 0.05", "legendFormat": "agent latency (90 s)" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "custom": { "thresholdsStyle": { "mode": "line" } }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 6 }, { "color": "red", "value": 14.4 }] } } }
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 2
}
