# ============================================================================
# .dockerignore - files NOT sent to `docker build .` (main Python image)
# ============================================================================
# IMPORTANT: .dockerignore does NOT support inline comments. A line like
#   "uploads/  # comment"
# is treated as the literal pattern "uploads/  # comment" and matches nothing,
# so every pattern below sits on its own line with comments above it.
# ============================================================================

# Version control / CI
.git
.gitignore
.github

# Secrets and environment files - must never end up in an image layer
.env
.env.*
!.env.example
secrets
config/nginx/ssl
*.pem
*.key
kubeconfig*

# Python caches, virtualenvs, build artifacts
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
*.egg-info
*.egg
dist
build
.venv
venv
env
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
coverage.xml
htmlcov

# Next.js frontend has its own image (context: ./frontend)
frontend
node_modules

# Runtime data - provided by volumes / services, never baked in
logs
data
uploads
memory
backups
migrations
*.log
conversation_memory.json
fact_memory.json

# Deployment manifests / other Dockerfiles (not needed inside the image)
k8s
docker-compose*.yml
Dockerfile.nginx

# Docs (README kept)
docs
*.md
!README.md

# Editors / OS junk
.idea
.vscode
*.swp
*.swo
*~
.DS_Store
Thumbs.db
