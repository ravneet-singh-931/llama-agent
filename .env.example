# Environment Variables
# Copy this file to .env and fill in your values. NEVER commit your real .env!
#
# In Docker Compose / Kubernetes, secrets are normally supplied as FILES
# (secrets/*.txt -> /run/secrets/<name>, read via *_FILE variables) rather
# than env values; plain env vars below are for running the API locally.

# --- Required -----------------------------------------------------------------
# Groq API key - https://console.groq.com/
GROQ_API_KEY=gsk_YOUR_KEY_HERE
# GROQ_API_KEY_FILE=/run/secrets/groq_api_key

# JWT signing secret (REQUIRED when ENVIRONMENT=production; the app refuses to
# start without it). Generate: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET_KEY=
# JWT_SECRET_KEY_FILE=/run/secrets/jwt_secret_key
# JWT_EXPIRE_MINUTES=30
# JWT_REFRESH_EXPIRE_DAYS=7

# --- Environment ----------------------------------------------------------------
# development | production
# ENVIRONMENT=development

# --- Models (Groq) --------------------------------------------------------------
# Strong tier: multi-agent, document answers, one-shot runs
# LLM_MODEL_STRONG=qwen/qwen3.8-27b
# Fast tier: streaming chat, query reformulation, helpers, 429 fallback
# LLM_MODEL_FAST=openai/gpt-oss-20b
# Legacy single-model override (used when the tier vars are unset)
# LLM_MODEL=qwen/qwen3.8-27b

# --- Optional tools ------------------------------------------------------------
# Tavily web search (research / analyzer agents)
# TAVILY_API_KEY=tvly_YOUR_KEY_HERE
# TAVILY_API_KEY_FILE=/run/secrets/tavily_api_key
# Tavily search depth: basic (1 credit/search) or advanced (2 credits, richer snippets)
# TAVILY_SEARCH_DEPTH=basic

# Agent answer budgets (tokens) and the timezone used for "today's date" in prompts
# AGENT_MAX_TOKENS=4096
# AGENT_CODER_MAX_TOKENS=6144
# CHAT_MAX_TOKENS=4096
# APP_TIMEZONE=Asia/Kolkata

# LLMOps guard (modules/llm_guard.py) - keeps agents inside Groq FREE-tier limits.
# Max input tokens per request; larger requests are compacted (old tool results first)
# LLM_INPUT_BUDGET=6000
# LLM_INPUT_BUDGET_STRONG=6000
# LLM_INPUT_BUDGET_FAST=6000
# Input tokens/minute per model (Groq free tier); tracked in Redis across replicas
# LLM_ITPM_LIMIT_STRONG=7000
# LLM_ITPM_LIMIT_FAST=8000
# 1 = switch strong->fast BEFORE the strong model's minute budget is exceeded
# LLM_PROACTIVE_DOWNGRADE=1
# Max seconds to wait for capacity when every model is saturated
# LLM_GUARD_MAX_WAIT_S=20
# Size caps: one tool result, one search snippet, one agent-to-agent hand-off (chars)
# AGENT_TOOL_RESULT_CHARS=4000
# WEB_SNIPPET_CHARS=600
# AGENT_HANDOFF_CHARS=12000

# Grounding guardrail (modules/grounding.py): figures not found in the tool results
# 1 = mark unsupported figures "(unverified)" in agent-to-agent hand-offs (default 1)
# AGENT_HANDOFF_FACTCHECK=1
# 1 = also mark them in single-agent answers; 0 = report in the Reasoning view only
# AGENT_FACTCHECK_MARK=0

# Evaluation suite (python -m evals.run): judge model and default report path
# EVAL_JUDGE_MODEL=openai/gpt-oss-20b
# EVAL_OUT=/tmp/eval-report.json

# --- Storage --------------------------------------------------------------------
# DATABASE_URL has NO password - it is injected from POSTGRES_PASSWORD(_FILE).
# DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/llama_agent
# POSTGRES_PASSWORD=
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
# Redis: shared rate limits, facts, WebSocket tickets (needed with >1 API replica)
# REDIS_URL=redis://localhost:6379
# Shared ChromaDB server (unset = local persistent client)
# CHROMA_SERVER_URL=http://localhost:8002
# UPLOAD_DIR=uploads

# --- RAG ------------------------------------------------------------------------
# USE_OPTIMIZED_RAG=true
# RAG_CRAG=1            # 0 = skip the answer check (on by default)
# RERANKER_MODEL_DIR=models/reranker   # local dev: python scripts/download_reranker.py models/reranker
# RAG_DECOMPOSE=0       # 1 = split complex questions into sub-questions
# RAG_QUERY_REWRITE=1   # rewrite follow-up questions using chat history
# DOC_ANSWER_MAX_TOKENS=2048   # token budget for document answers/comparisons
# RAG_BM25_TTL=300      # seconds before the BM25 index is rebuilt

# --- Monitoring -----------------------------------------------------------------
# 1 = serve /metrics even through a reverse proxy (default: 404 when proxied)
# METRICS_ALLOW_PROXIED=0
# Cost tracking price overrides (USD per 1M tokens)
# GROQ_PRICING={"qwen/qwen3.8-27b": {"input": 0.20, "output": 0.60}}
# GROQ_DEFAULT_PRICE_IN=0.15
# GROQ_DEFAULT_PRICE_OUT=0.60

# --- Nginx (Compose) ------------------------------------------------------------
# Common name for the auto-generated self-signed cert (when config/nginx/ssl/ is empty)
# SSL_CN=localhost

# --- MCP ------------------------------------------------------------------------
# MCP_SERVER_URL=http://localhost:8001/sse

# ==============================================================================
# Advanced tuning — every variable the code reads that is not already listed above
# ==============================================================================
#
# Auto-derived from the source: each row was extracted from an
# os.getenv()/os.environ.get() call, so this section cannot claim a variable that
# is not read. Defaults are the literal second argument at the call site.
#
# You do not need to set any of these. They exist so that behaviour which is
# currently invisible in the config surface is at least discoverable.
#
# NOTE: three FEATURE_* flags below are declared and read by nothing. They are
# kept here, labelled, rather than silently omitted - see docs/DARK_MODULES.md.

# --- Agent loop and team behaviour -------------------------------------
# Max entries in the per-agent tool-result cache.
# read in: llama_agent1.py   default: 256
# AGENT_CACHE_MAX=256

# Seconds a cached tool result stays valid (default 600 in llama_agent1, 60 elsewhere).
# read in: llama_agent1.py   default: 60
# AGENT_CACHE_TTL=60

# `1`/`0`. Adds a critic pass that reviews the team answer before it is returned.
# read in: api.py   default: 1
# AGENT_CRITIQUE=1

# Soft wall-clock budget (s) for one multi-agent task.
# read in: multi_agent.py   default: 180
# AGENT_LATENCY_BUDGET=180

# How many times the identical tool call may repeat before the loop stops it.
# read in: modules/agent_tools.py   default: 2
# AGENT_MAX_IDENTICAL_CALLS=2

# Token ceiling for the accumulated tool results in one loop.
# read in: modules/agent_tools.py   default: 48000
# AGENT_MAX_TOOL_TOKENS=48000

# `1`/`0`. Let agents keep task memory across steps.
# read in: multi_agent.py   default: 1
# AGENT_MEMORY=1

# Max entries in agent task memory.
# read in: multi_agent.py   default: 200
# AGENT_MEMORY_MAX=200

# `ThreadPoolExecutor` width for parallel agent steps.
# read in: multi_agent.py   default: 4
# AGENT_PARALLEL=4

# `1`/`0`. Run independent team steps concurrently.
# read in: api.py   default: 1
# AGENT_PARALLEL_STEPS=1

# `1`/`0`. Adds a self-reflection pass that revises the answer.
# read in: api.py   default: 1
# AGENT_REFLECT=1

# Max reflection rounds.
# read in: multi_agent.py   default: 1
# AGENT_REFLECT_MAX=1

# Characters of each source shown to the critic.
# read in: multi_agent.py   default: 4000
# AGENT_REVIEW_SOURCE_CHARS=4000

# Per-step timeout (s) inside a multi-agent task.
# read in: multi_agent.py   default: 150
# AGENT_STEP_TIMEOUT=150

# Overall timeout (s) for a multi-agent task.
# read in: api.py   default: 60
# AGENT_TIMEOUT=60

# Token budget for one agent task.
# read in: multi_agent.py   default: 20000
# AGENT_TOKEN_BUDGET=20000

# Window (s) over which the per-user token budget is counted.
# read in: modules/llm_guard.py   default: 86400
# AGENT_USER_BUDGET_WINDOW=86400


# --- Model tiers and alternate providers --------------------------------
# These are read INDIRECTLY: modules/model_tiers.py maps a provider name to its
# two env-var NAMES and reads them dynamically, so a plain os.getenv grep does
# not find them. They are real, and none of them is required: Groq is the
# default and is always the final fallback in LLM_PROVIDER_CHAIN.
#
# To actually use OpenAI or Anthropic you must set LLM_PROVIDER_CHAIN (above)
# AND the key AND both model names for that provider.
# GROQ_MODEL_STRONG=
# GROQ_MODEL_FAST=
# OPENAI_MODEL_STRONG=
# OPENAI_MODEL_FAST=
# OPENAI_API_KEY=
# ANTHROPIC_MODEL_STRONG=
# ANTHROPIC_MODEL_FAST=
# ANTHROPIC_API_KEY=

# --- Evaluation runner -------------------------------------------------
# Per-case input-token budget for a run (see README row 39).
# read in: modules/llm_guard.py   default: 9000
# EVAL_CASE_TOKEN_BUDGET=9000

# Daily per-model token cap; the preflight compares a run against it.
# read in: evals/run.py   default: 200000
# EVAL_DAILY_TOKEN_CAP=200000

# Pass threshold for figure grounding.
# read in: evals/run.py   default: 0.7
# EVAL_GROUNDING_THRESHOLD=0.7

# Max output tokens for one judge call.
# read in: evals/judge.py   default: 2000
# EVAL_JUDGE_MAX_TOKENS=2000

# Characters of source material given to the judge.
# read in: evals/judge.py   default: 8000
# EVAL_JUDGE_SOURCE_CHARS=8000

# Timeout (s) for a judge call.
# read in: evals/run.py   default: 180
# EVAL_JUDGE_TIMEOUT=180

# Below this graded share the report prints INCONCLUSIVE instead of a rate (default 90).
# read in: evals/run.py   default: 90
# EVAL_MIN_GRADED_PCT=90

# Where `--record` writes the replayable artefact.
# read in: modules/recording.py   default: evals/recordings
# EVAL_RECORD_DIR=evals/recordings

# Record / replay / off.
# read in: llama_agent1.py   default: —
# EVAL_RECORD_MODE=


# --- MCP client --------------------------------------------------------
# SSE connect timeout (s) for the MCP client.
# read in: modules/mcp_client.py   default: 5
# MCP_SSE_CONNECT_TIMEOUT=5

# SSE read timeout (s) for the MCP client.
# read in: modules/mcp_client.py   default: 300
# MCP_SSE_READ_TIMEOUT=300

# Max characters of an MCP task description.
# read in: mcp_agents_server.py   default: 10000
# MCP_TASK_MAX=10000

# Overall MCP client timeout (s).
# read in: api.py   default: 25
# MCP_TIMEOUT=25

# Per-tool timeout (s) inside the MCP server.
# read in: mcp_agents_server.py   default: 120
# MCP_TOOL_TIMEOUT=120


# --- Retrieval tuning --------------------------------------------------
# Semantic-cache hit ceiling: a query further than this from a cached one is a miss.
# read in: modules/rag_optimizations.py   default: 0.05
# RAG_CACHE_MAX_DISTANCE=0.05

# `1`/`0`. Contextual chunk summaries at index time (off in the chat path; see README).
# read in: api.py   default: 0
# RAG_CONTEXTUAL=0

# Characters of context given to the CRAG relevance check.
# read in: modules/rag_optimizations.py   default: 12000
# RAG_CRAG_CONTEXT_CHARS=12000

# Max output tokens for the CRAG check.
# read in: modules/rag_optimizations.py   default: 1024
# RAG_CRAG_MAX_TOKENS=1024

# Max tokens for a chunk summary.
# read in: modules/rag_optimizations.py   default: 1024
# RAG_SUMMARY_MAX_TOKENS=1024


# --- Feature flags (read from env) -------------------------------------
# These are *system A*. Three of them decide nothing — see docs/DARK_MODULES.md.
# `true`/`false`. Gates database initialisation; it does **not** disable auth (per-route guards are unconditional).
# read in: modules/config.py   default: true
# FEATURE_AUTH=true

# `true`/`false`. Declared but no branch reads it — the cache runs unconditionally.
# read in: modules/config.py   default: true
# FEATURE_CACHING=true

# `true`/`false`. Declared but no branch reads it.
# read in: modules/config.py   default: true
# FEATURE_METRICS=true

# `true`/`false`. Declared but no branch reads it — `rate_limiter.is_rate_limited()` runs unconditionally.
# read in: modules/config.py   default: true
# FEATURE_RATE_LIMITING=true

# `true`/`false`. Only used to label `/status` as active/disabled; it does not stop the endpoint.
# read in: modules/config.py   default: true
# FEATURE_WEBSOCKETS=true


# --- Model and provider limits -----------------------------------------
# Max output tokens for the main model.
# read in: modules/config.py   default: 1024
# LLM_MAX_TOKENS=1024

# Ordered comma-separated providers to try (default `groq`).
# read in: modules/config.py   default: groq
# LLM_PROVIDER_CHAIN=groq


# --- Groq client -------------------------------------------------------
# Retries on a Groq API error.
# read in: llama_agent1.py   default: 2
# GROQ_MAX_RETRIES=2

# Groq client timeout (s).
# read in: llama_agent1.py   default: 60
# GROQ_TIMEOUT=60


# --- Rate limiting -----------------------------------------------------
# `1`/`0`. Turns the per-IP limiter on or off.
# read in: modules/config.py   default: true
# RATE_LIMIT_ENABLED=true

# Requests per hour per IP.
# read in: modules/config.py   default: 1000
# RATE_LIMIT_RPH=1000

# Requests per minute per IP.
# read in: modules/config.py   default: 60
# RATE_LIMIT_RPM=60


# --- Database pool -----------------------------------------------------
# `1`/`0`. Log every SQL statement.
# read in: modules/config.py   default: false
# DB_ECHO=false

# Extra connections allowed above `DB_POOL_SIZE`.
# read in: modules/config.py   default: 10
# DB_MAX_OVERFLOW=10

# SQLAlchemy async pool size.
# read in: modules/config.py   default: 20
# DB_POOL_SIZE=20


# --- Postgres connection -----------------------------------------------
# Database name.
# read in: app.py   default: llama_agent
# POSTGRES_DB=llama_agent

# Database port.
# read in: app.py   default: 5432
# POSTGRES_PORT=5432

# Database user.
# read in: app.py   default: postgres
# POSTGRES_USER=postgres


# --- Conversation memory -----------------------------------------------
# `redis` or `file`. Where conversation history lives.
# read in: modules/memory.py   default: auto
# CONV_MEMORY_BACKEND=auto

# Seconds a conversation is retained.
# read in: modules/memory.py   default: str(7 * 24 * 3600
# CONV_MEMORY_TTL=str(7 * 24 * 3600


# --- Everything else ------------------------------------------------------
# Bind address for uvicorn.
# read in: modules/config.py   default: 0.0.0.0
# API_HOST=0.0.0.0

# Bind port for uvicorn.
# read in: modules/config.py   default: 8000
# API_PORT=8000

# Comma-separated allow-list. Note: `api.py` builds its list inline; this variable is read elsewhere and does not change the middleware.
# read in: modules/config.py   default: *
# CORS_ORIGINS=*

# `1`/`0`. Debug logging.
# read in: modules/config.py   default: false
# DEBUG=false

# Timeout (s) for a call to a downstream service.
# read in: api.py   default: 30
# DOWNSTREAM_TIMEOUT=30

# Set by GitHub Actions; the eval runner writes its summary there.
# read in: evals/rag_eval.py   default: —
# GITHUB_STEP_SUMMARY=

# Build stamp shown as the version suffix.
# read in: evals/rag_eval.py   default: —
# GIT_SHA=

# JWT signing algorithm (HS256).
# read in: modules/auth.py   default: HS256
# JWT_ALGORITHM=HS256

# Turns of history passed to the orchestrator.
# read in: multi_agent.py   default: 200
# ORCH_HISTORY_MAX=200

# Prompt-set version string reported by `/health`.
# read in: evals/run.py   default: —
# PROMPT_VERSION=

# Redis connection pool size.
# read in: modules/config.py   default: 20
# REDIS_MAX_CONNECTIONS=20

# ONNX runtime thread count for the cross-encoder reranker.
# read in: modules/rag_optimizations.py   default: 2
# RERANKER_THREADS=2

# Max seconds a `/chat/stream` response may run.
# read in: api.py   default: 300
# STREAM_MAX_DURATION=300

# Max characters of a web-search query.
# read in: modules/web_tools.py   default: 400
# WEB_MAX_QUERY_CHARS=400
