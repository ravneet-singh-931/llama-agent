# Environment Variables
# Copy this file to .env and fill in your values. NEVER commit your real .env!
#
# In Docker Compose / Kubernetes, secrets are normally supplied as FILES
# (secrets/*.txt -> /run/secrets/<name>, read via *_FILE variables) rather
# than env values; plain env vars below are for running the API locally.

# --- Required -----------------------------------------------------------------
# Groq API key - https://console.groq.com/
GROQ_API_KEY=gsk_YOUR_KEY_HERE
# GROQ_API_KEY_FILE=/run/secrets/groq_api_key

# JWT signing secret (REQUIRED when ENVIRONMENT=production; the app refuses to
# start without it). Generate: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET_KEY=
# JWT_SECRET_KEY_FILE=/run/secrets/jwt_secret_key
# JWT_EXPIRE_MINUTES=30
# JWT_REFRESH_EXPIRE_DAYS=7

# --- Environment ----------------------------------------------------------------
# development | production
# ENVIRONMENT=development

# --- Models (Groq) --------------------------------------------------------------
# Strong tier: multi-agent, document answers, one-shot runs
# LLM_MODEL_STRONG=qwen/qwen3.8-27b
# Fast tier: streaming chat, query reformulation, helpers, 429 fallback
# LLM_MODEL_FAST=openai/gpt-oss-20b
# Legacy single-model override (used when the tier vars are unset)
# LLM_MODEL=qwen/qwen3.8-27b

# --- Optional tools ------------------------------------------------------------
# Tavily web search (research / analyzer agents)
# TAVILY_API_KEY=tvly_YOUR_KEY_HERE
# TAVILY_API_KEY_FILE=/run/secrets/tavily_api_key
# Tavily search depth: basic (1 credit/search) or advanced (2 credits, richer snippets)
# TAVILY_SEARCH_DEPTH=basic

# Agent answer budgets (tokens) and the timezone used for "today's date" in prompts
# AGENT_MAX_TOKENS=4096
# AGENT_CODER_MAX_TOKENS=6144
# CHAT_MAX_TOKENS=4096
# APP_TIMEZONE=Asia/Kolkata

# LLMOps guard (modules/llm_guard.py) - keeps agents inside Groq FREE-tier limits.
# Max input tokens per request; larger requests are compacted (old tool results first)
# LLM_INPUT_BUDGET=6000
# LLM_INPUT_BUDGET_STRONG=6000
# LLM_INPUT_BUDGET_FAST=6000
# Input tokens/minute per model (Groq free tier); tracked in Redis across replicas
# LLM_ITPM_LIMIT_STRONG=7000
# LLM_ITPM_LIMIT_FAST=8000
# 1 = switch strong->fast BEFORE the strong model's minute budget is exceeded
# LLM_PROACTIVE_DOWNGRADE=1
# Max seconds to wait for capacity when every model is saturated
# LLM_GUARD_MAX_WAIT_S=20
# Size caps: one tool result, one search snippet, one agent-to-agent hand-off (chars)
# AGENT_TOOL_RESULT_CHARS=4000
# WEB_SNIPPET_CHARS=600
# AGENT_HANDOFF_CHARS=12000

# --- Storage --------------------------------------------------------------------
# DATABASE_URL has NO password - it is injected from POSTGRES_PASSWORD(_FILE).
# DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/llama_agent
# POSTGRES_PASSWORD=
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
# Redis: shared rate limits, facts, WebSocket tickets (needed with >1 API replica)
# REDIS_URL=redis://localhost:6379
# Shared ChromaDB server (unset = local persistent client)
# CHROMA_SERVER_URL=http://localhost:8002
# UPLOAD_DIR=uploads

# --- RAG ------------------------------------------------------------------------
# USE_OPTIMIZED_RAG=true
# RAG_CRAG=0            # 1 = verify answers against context, retry if unsupported
# RAG_DECOMPOSE=0       # 1 = split complex questions into sub-questions
# RAG_QUERY_REWRITE=1   # rewrite follow-up questions using chat history
# RAG_BM25_TTL=300      # seconds before the BM25 index is rebuilt

# --- Monitoring -----------------------------------------------------------------
# 1 = serve /metrics even through a reverse proxy (default: 404 when proxied)
# METRICS_ALLOW_PROXIED=0
# Cost tracking price overrides (USD per 1M tokens)
# GROQ_PRICING={"qwen/qwen3.8-27b": {"input": 0.20, "output": 0.60}}
# GROQ_DEFAULT_PRICE_IN=0.15
# GROQ_DEFAULT_PRICE_OUT=0.60

# --- Nginx (Compose) ------------------------------------------------------------
# Common name for the auto-generated self-signed cert (when config/nginx/ssl/ is empty)
# SSL_CN=localhost

# --- MCP ------------------------------------------------------------------------
# MCP_SERVER_URL=http://localhost:8001/sse
